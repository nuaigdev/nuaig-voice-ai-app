# Which client (community) this deployment serves - a key in src/clients/index.ts.
CLIENT_ID=seabury

# Supabase auth. `npm run supabase:start` prints local values for these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only used by `npm run create-account`.
SUPABASE_SERVICE_ROLE_KEY=

# This client's Retell account and voice agent.
RETELL_API_KEY=
AGENT_ID=
# RETELL_BASE_URL=https://api.retellai.com

# Local demo mode (sample data + demo login, `next dev` only). Prefer `npm run dev:demo`.
# NUVA_DEMO=1
