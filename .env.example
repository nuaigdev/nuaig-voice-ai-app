# Which client (community) this deployment serves - a key in src/clients/index.ts.
CLIENT_ID=seabury

# This client's Retell account and voice agent.
RETELL_API_KEY=
AGENT_ID=
# RETELL_BASE_URL=https://api.retellai.com

# Interim sign-in: one shared admin account. Signs the session cookie (required in production builds).
AUTH_SECRET=
# Only when serving over plain http (no TLS yet): lets the login cookie work off-localhost.
# AUTH_COOKIE_INSECURE=1
# Defaults to demo@nuva.dev / nuva-demo when unset.
# CONSOLE_LOGIN_EMAIL=
# CONSOLE_LOGIN_PASSWORD=

# Fixture mode (sample calls, no Retell; `next dev` only). Prefer `npm run dev:demo`.
# NUVA_DEMO=1
